{
  "info": {
    "name": "Session Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "dateTimestamp", "value": "" },
    { "key": "lastEmail", "value": "" }
  ],
  "item": [
    {
      "name": "Create User",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const d = pm.response.json().data;",
        "pm.test('201 Created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('userId', d._id);",
        "pm.collectionVariables.set('lastEmail', d.email);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane{{$timestamp}}@example.com\",\n  \"phone\": \"9876543210\"\n}" },
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
      }
    },
    {
      "name": "Create User - duplicate email (409)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Duplicate\",\n  \"email\": \"{{lastEmail}}\",\n  \"phone\": \"9876543210\"\n}" },
        "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
      }
    },
    {
      "name": "Create Teacher (helper)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('201 Created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('teacherId', pm.response.json().data._id);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"John Smith\",\n  \"email\": \"john@example.com\",\n  \"specialization\": \"Mathematics\",\n  \"experience\": 8\n}" },
        "url": { "raw": "{{baseUrl}}/teachers", "host": ["{{baseUrl}}"], "path": ["teachers"] }
      }
    },
    {
      "name": "Create Session",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('201 Created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('sessionId', pm.response.json().data._id);",
        "pm.collectionVariables.set('dateTimestamp', new Date('2030-01-01T10:00:00.000Z').getTime());"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2030-01-01T10:00:00.000Z\",\n  \"endTime\": \"2030-01-01T11:00:00.000Z\"\n}" },
        "url": { "raw": "{{baseUrl}}/sessions", "host": ["{{baseUrl}}"], "path": ["sessions"] }
      }
    },
    {
      "name": "Create Session - endTime before startTime (400)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2030-01-01T11:00:00.000Z\",\n  \"endTime\": \"2030-01-01T10:00:00.000Z\"\n}" },
        "url": { "raw": "{{baseUrl}}/sessions", "host": ["{{baseUrl}}"], "path": ["sessions"] }
      }
    },
    {
      "name": "Available Sessions",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('contains the new session', () => pm.expect(pm.response.json().data.map(s => s._id)).to.include(pm.collectionVariables.get('sessionId')));"
      ] } }],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "available"],
          "query": [{ "key": "dateTimestamp", "value": "{{dateTimestamp}}" }]
        }
      }
    },
    {
      "name": "Book Session",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('status is BOOKED', () => pm.expect(pm.response.json().data.status).to.eql('BOOKED'));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/sessions/{{sessionId}}/book", "host": ["{{baseUrl}}"], "path": ["sessions", "{{sessionId}}", "book"] }
      }
    },
    {
      "name": "Book Session again (409)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/sessions/{{sessionId}}/book", "host": ["{{baseUrl}}"], "path": ["sessions", "{{sessionId}}", "book"] }
      }
    },
    {
      "name": "User Sessions (upcoming)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('1 upcoming', () => pm.expect(pm.response.json().data.upcomingSessions.length).to.eql(1));"
      ] } }],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/users/{{userId}}/sessions", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}", "sessions"] }
      }
    },
    {
      "name": "Complete Session",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('status is COMPLETED', () => pm.expect(pm.response.json().data.status).to.eql('COMPLETED'));"
      ] } }],
      "request": {
        "method": "PATCH",
        "header": [],
        "url": { "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete", "host": ["{{baseUrl}}"], "path": ["sessions", "{{sessionId}}", "complete"] }
      }
    },
    {
      "name": "User Sessions (completed)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('1 completed', () => pm.expect(pm.response.json().data.completedSessions.length).to.eql(1));"
      ] } }],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/users/{{userId}}/sessions", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}", "sessions"] }
      }
    }
  ]
}
